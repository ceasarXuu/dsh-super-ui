{
  "name": "@ceasarxuu/dsh-super-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Super UI: interface-wide tweaks for DeepSeek Harness. First feature: an independent font-size scale for the UI outside the chat surface (sidebars, settings pages, menus, dialogs) with a native General settings row.",
  "license": "MIT",
  "author": "ceasarXuu",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "font-size",
    "sidebar",
    "accessibility"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "dev"
  ],
  "scripts": {
    "check": "node --check index.js && node --check host/config.js && node --check client.js",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
