{
  "name": "@ceasarxuu/dsh-super-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Super UI: interface-wide tweaks for DeepSeek Harness. First feature merges the shipped font-size row into two options — Chat font size (conversation content) and Interface font size (the rest of the interface, scaled live) — and keeps the shipped body/code/terminal font settings under More font settings.",
  "license": "MIT",
  "author": "ceasarXuu",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "font-size",
    "sidebar",
    "accessibility"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.0 <0.3.0-0",
    "node": "^24.22.3 || >=26.13.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "host/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node dev/build-client.mjs",
    "check": "node dev/build-client.mjs && node --check index.js && node --check host/config.js && node --check client.js",
    "test": "node dev/build-client.mjs && node --test --test-force-exit test/*.test.mjs",
    "verify:browser": "node dev/build-client.mjs && node dev/verify-browser.mjs",
    "verify:row": "node dev/build-client.mjs && node dev/verify-row-layout.mjs",
    "verify": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "homepage": "https://github.com/ceasarXuu/dsh-super-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceasarXuu/dsh-super-ui.git"
  },
  "bugs": {
    "url": "https://github.com/ceasarXuu/dsh-super-ui/issues"
  }
}
